# infra-utm-redteam-lab configuration
# Copy to lab.conf and adjust. lab.conf is gitignored.

# --- Identity ---------------------------------------------------------------
# Prefix for all VM names in UTM, so the whole lab is easy to spot and remove.
LAB_PREFIX="redteam"

# User created inside every VM (cloud-init). Ansible connects as this user.
# Avoid a name that is already a system group in the guest: Debian and Kali
# ship legacy groups like operator (GID 37), staff, games and users. The
# cloud-init template handles the clash, but a free name keeps it simple.
LAB_USER="redteam"

# --- Attacker login ---------------------------------------------------------
# Password for the lab user on the attacker (Kali) box. The base image
# auto-logs-in on the console and the optional GUI; the attacker role instead
# sets this password, removes the auto-login, and leaves a login prompt on both.
# Left unset it defaults to 'redteam'. lab.conf is gitignored, so a real value
# never lands in git. This is the console/GUI password only; SSH stays key-only.
ATTACKER_PASSWORD="redteam"

# Public SSH key injected into every VM. Generated automatically by
# scripts/preflight.sh if the file does not exist.
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_redteam.pub"

# --- Networking -------------------------------------------------------------
# The two-NIC layout is fixed by scripts/create-vm.applescript and not
# configurable here: every VM gets a NAT NIC (internet + the host SSH forward)
# plus a host-only NIC on the isolated 10.10.10.0/24 lab segment. "Isolated"
# means that segment only -- the NAT NIC also reaches your real LAN, not just
# the internet. See docs/network.md, including how to drop the NAT NIC for a
# fully offline target.

# --- Resource defaults ------------------------------------------------------
# Defaults for every VM in LAB_VMS below. A VM overrides any of these with a
# cpu= / ram= / disk= field in its fleet entry.
LAB_CPU=2
LAB_RAM=2048
LAB_DISK_GB=20

# --- Base images (ARM64 / aarch64) ------------------------------------------
# Targets run Ubuntu; the attacker runs Kali. The base image is chosen per role
# (see scripts/lib.sh role_image). Checksums are verified against the SHA256SUMS
# published alongside each image.
UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-arm64.img"
UBUNTU_SHA_URL="https://cloud-images.ubuntu.com/releases/26.04/release/SHA256SUMS"

# Kali attacker image (ARM64 genericcloud, cloud-init enabled). It ships as a
# .tar.xz containing a raw disk (disk.raw); fetch-images.sh verifies the archive,
# extracts it and renames it to KALI_IMG_FILE. The raw image is ~25 GiB (already
# larger than LAB_DISK_GB, so create-vm.sh never shrinks it).
#
# The URLs point at Kali's per-release directory (kali-<version>/), NOT current/.
# current/ only ever holds the newest build, so a pin there 404s the moment Kali
# cuts a release; the versioned directory keeps its image and SHA256SUMS in place
# afterwards. Bumping KALI_VERSION selects the matching directory, so pick any
# release listed at https://kali.download/cloud-images/ (mirror of
# https://www.kali.org/releases/). Very old releases are eventually pruned from
# kali.download to https://old.kali.org/cloud-images/.
KALI_VERSION="2026.2"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"

# --- Attacker toolset -------------------------------------------------------
# Which Kali tools the 'attacker' role installs. Bigger = slower first `make up`.
#   curated  : fast headless subset (nmap, netcat, gobuster, ffuf, hydra,
#              sqlmap, metasploit-framework, seclists)
#   headless : full 'kali-linux-headless' metapackage (the standard Kali toolset)
#   large    : 'kali-linux-large' (an even broader set)
ATTACKER_TOOLSET="curated"

# --- Attacker desktop (optional GUI) ----------------------------------------
# The attacker is headless by default (the base images ship no desktop). Set
# this to 'xfce' to install a lightweight XFCE desktop that renders in UTM's own
# window (via the virtio-gpu console the attacker role already configures) and
# prompts for the ATTACKER_PASSWORD above at the LightDM greeter. 'none'
# (default) installs nothing.
#
# A desktop wants more memory: give the attacker ram=3072 or more (the default
# fleet below already uses 4096) plus a little extra disk. Turning this back to
# 'none' does NOT uninstall an already-installed desktop (changes are
# non-destructive, like disk=); run 'make destroy' then 'make up' for a clean
# headless box again.
ATTACKER_GUI="none"

# --- VM fleet ---------------------------------------------------------------
# Each entry: "name:role [cpu=N] [ram=MiB] [disk=GB]"
#
#   name   short name: the UTM VM is LAB_PREFIX-name, and this is what
#          'make ssh' and the Ansible inventory use
#   role   maps to a base image (attacker=Kali, anything else=Ubuntu), a
#          cloud-init seed and an Ansible group
#   cpu    CPU cores       (default: LAB_CPU)
#   ram    memory in MiB   (default: LAB_RAM)
#   disk   disk size in GB (default: LAB_DISK_GB)
#   state  REQUIRED, "on" or "off": pause a VM without losing its slot
#
# cpu/ram/disk are optional and their order does not matter; a VM that names
# none of them uses the defaults above. state= must be present on EVERY entry,
# so a VM's place in the lab is always an explicit choice. Give the attacker
# room if you raise ATTACKER_TOOLSET: kali-linux-large does not fit in 20 GB.
#
# state=off skips a VM in 'make up' / 'make provision' (stopping it if it is
# running) and leaves it out of Ansible, but KEEPS its index — its lab IP and
# SSH port stay reserved, so toggling other VMs on/off later never shifts the
# addresses of the rest. 'make status' marks it "(off)"; 'make down' and
# 'make destroy' still cover it. Freeing its resources completely still means
# removing the line (which shifts the addresses of every VM below it) or
# 'make destroy'.
#
# Changing cpu= or ram= for a VM that already exists makes the next 'make up'
# stop that VM, apply the change, and start it again. VMs whose cpu/ram did
# not change are never restarted.
#
# disk= is only applied when a VM is first created: UTM imports the staged
# disk into its own bundle at creation time, so raising disk= later has no
# effect on a VM that already exists. To grow the disk of an existing VM, run
# 'make destroy' then 'make up'. Disks are never shrunk either way: lowering
# disk= on an existing VM warns and leaves it untouched.
#
# Add a line plus a matching Ansible role to grow the lab (see README).
LAB_VMS=(
  "attacker:attacker cpu=4 ram=4096 disk=60 state=on"
  "vuln-web:vuln-web state=on"
  "vuln-net:vuln-net state=on"
  "vuln-docker:vuln-docker ram=4096 state=on"
  "vuln-k8s:vuln-k8s ram=4096 state=on"
)
