# infra-utm-redteam-lab configuration
# Copy to lab.conf and adjust. lab.conf is gitignored.

# --- Identity ---------------------------------------------------------------
# Prefix for all VM names in UTM.
LAB_PREFIX="redteam"

# User created inside every VM (cloud-init); Ansible connects as this user.
# Avoid names colliding with legacy guest groups (operator, staff, games).
LAB_USER="redteam"

# Console/GUI password on the attacker box; the role removes the Kali image's
# auto-login. Defaults to 'redteam'. SSH stays key-only.
ATTACKER_PASSWORD="redteam"

# Public SSH key injected into every VM; generated by preflight if missing.
LAB_SSH_KEY="${HOME}/.ssh/id_ed25519_redteam.pub"

# --- Networking -------------------------------------------------------------
# The two-NIC layout is fixed by scripts/create-vm.applescript: a NAT NIC
# (internet + host SSH forward, also reaches your real LAN) plus a host-only
# NIC on the isolated 10.10.10.0/24 lab segment. See docs/network.md.

# --- Resource defaults ------------------------------------------------------
# Per-VM defaults; overridden by cpu= / ram= / disk= in a fleet entry.
LAB_CPU=2
LAB_RAM=2048
LAB_DISK_GB=20

# --- Base images (ARM64) ----------------------------------------------------
# Targets run Ubuntu, the attacker runs Kali (see role_image in scripts/lib.sh).
# Checksums are verified against the published SHA256SUMS.
UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/releases/26.04/release/ubuntu-26.04-server-cloudimg-arm64.img"
UBUNTU_SHA_URL="https://cloud-images.ubuntu.com/releases/26.04/release/SHA256SUMS"

# Kali genericcloud ships as a .tar.xz containing a ~25 GiB raw disk (already
# larger than LAB_DISK_GB, so never shrunk). The URLs point at the per-release
# kali-<version>/ directory, not current/, which 404s once a new release is
# cut. Pick releases from https://kali.download/cloud-images/; very old ones
# move to https://old.kali.org/cloud-images/.
KALI_VERSION="2026.2"
KALI_IMG_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/kali-linux-${KALI_VERSION}-cloud-genericcloud-arm64.tar.xz"
KALI_SHA_URL="https://kali.download/cloud-images/kali-${KALI_VERSION}/SHA256SUMS"
KALI_IMG_FILE="kali-genericcloud-arm64.raw"

# --- Attacker toolset -------------------------------------------------------
# curated (fast subset) | headless (kali-linux-headless) | large (kali-linux-large).
# Bigger = slower first make up; large does not fit in a 20 GB disk.
ATTACKER_TOOLSET="curated"

# --- Attacker desktop (optional GUI) ----------------------------------------
# 'xfce' installs XFCE + LightDM in UTM's own window (wants ram=3072+; the
# fleet below already gives the attacker 4096). 'none' (default) installs
# nothing. Turning xfce back to none does not uninstall; use
# 'make destroy' + 'make up' for a clean headless box.
ATTACKER_GUI="none"

# --- VM fleet ---------------------------------------------------------------
# Entry: "name:role [cpu=N] [ram=MiB] [disk=GB] state=on|off"
#
#   name   UTM VM is LAB_PREFIX-name; used by 'make ssh' and the inventory
#   role   base image (attacker=Kali, else Ubuntu) and Ansible group
#   cpu/ram/disk   optional, default to LAB_* above
#   state  REQUIRED on every entry: on or off
#
# state=off skips a VM in 'make up' (stopping it if running) and drops it
# from Ansible, but KEEPS its index so its lab IP, SSH port and the other
# VMs' addresses never shift. 'make status' shows "(off)"; 'make down' and
# 'make destroy' still cover it. Targets default to off so 'make up' boots
# only the attacker.
#
# cpu=/ram= reconcile on the next 'make up' (that VM stops, changes, starts).
# disk= applies only at creation (UTM imports the disk into its own bundle):
# growing an existing VM's disk needs 'make destroy' + 'make up'. Disks are
# never shrunk.
#
# Append new entries at the end: inserting a line shifts the addresses of
# every VM below it. Add a matching Ansible role to grow the lab (see README).
LAB_VMS=(
  "attacker:attacker cpu=4 ram=4096 disk=60 state=on"
  "vuln-web:vuln-web state=off"
  "vuln-net:vuln-net state=off"
  "vuln-docker:vuln-docker ram=4096 state=off"
  "vuln-k8s:vuln-k8s ram=4096 state=off"
  "vuln-iot:vuln-iot state=off"
)
